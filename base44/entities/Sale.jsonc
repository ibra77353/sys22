{
  "name": "Sale",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "distributor_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0632\u0639"
    },
    "distributor_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0632\u0639"
    },
    "total_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a",
      "minimum": 0
    },
    "paid_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639",
      "minimum": 0
    },
    "remaining_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062a\u0628\u0642\u064a"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled"
      ],
      "default": "active",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u064a\u0639"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "items": {
      "type": "array",
      "title": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0628\u064a\u0639",
      "items": {
        "type": "object",
        "properties": {
          "package_id": {
            "type": "string"
          },
          "package_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "distributor_id",
    "total_amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}