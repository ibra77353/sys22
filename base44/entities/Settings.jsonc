{
  "name": "Settings",
  "type": "object",
  "properties": {
    "network_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0628\u0643\u0629",
      "default": "\u0634\u0628\u0643\u0629 \u0627\u0644\u0628\u0631\u0646\u0633"
    },
    "currency": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0645\u0644\u0629",
      "default": "\u0631\u064a\u0627\u0644 \u064a\u0645\u0646\u064a"
    },
    "currency_symbol": {
      "type": "string",
      "title": "\u0631\u0645\u0632 \u0627\u0644\u0639\u0645\u0644\u0629",
      "default": "\u0631.\u064a"
    },
    "admin_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u062f\u064a\u0631"
    },
    "opening_balance": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0627\u0641\u062a\u062a\u0627\u062d\u064a",
      "default": 0
    },
    "low_stock_threshold": {
      "type": "number",
      "title": "\u062d\u062f \u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0645\u062e\u0632\u0648\u0646",
      "default": 10
    }
  },
  "required": [
    "network_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
